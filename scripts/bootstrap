#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
if [ ! -x .venv/bin/python ]; then
    "${PYTHON:-python3.12}" -m venv .venv
fi
.venv/bin/python -c 'import sys; assert sys.version_info[:2] == (3, 12), "Use Python 3.12 (set PYTHON to its path)"'
.venv/bin/python -m pip install --disable-pip-version-check -q -r requirements.lock
.venv/bin/python -m pip install --disable-pip-version-check -q --no-deps --no-build-isolation -e .
