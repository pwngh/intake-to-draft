#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
./scripts/bootstrap
.venv/bin/python -m pip install --disable-pip-version-check -q --no-build-isolation '.[retrieval]'
.venv/bin/python scripts/evaluate_retrieval.py --download --output .runtime/retrieval-check.json
exec .venv/bin/python scripts/live_demo.py "$@"
